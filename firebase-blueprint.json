{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio artwork, installation, or performance project record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "year": { "type": "string" },
        "location": { "type": "string" },
        "discipline": { "type": "string" },
        "shortDescription": { "type": "string" },
        "statement": { "type": "string" },
        "heroImage": { "type": "string" },
        "dimensions": { "type": "string" },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "gallery": { "type": "array" },
        "specs": { "type": "object" },
        "credits": { "type": "object" },
        "technologies": { "type": "array" }
      },
      "required": ["id", "slug", "title", "category", "year", "heroImage"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration, biography, upcoming exhibitions, and contacts",
      "type": "object",
      "properties": {
        "aboutStatement": { "type": "string" },
        "bioParagraphs": { "type": "array" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "socials": { "type": "array" },
        "upcomingExhibitions": { "type": "array" }
      },
      "required": ["aboutStatement", "email", "location"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Public portfolio projects collection editable by verified admin"
    },
    "/siteSettings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Global website settings and biography information"
    }
  }
}
